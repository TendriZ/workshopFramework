# ============================================================
# APLIKASI LARAVEL - WORKSHOP FRAMEWORK
# File Konfigurasi Environment (.env.contoh)
# ============================================================
# Copy file ini ke .env dan sesuaikan dengan konfigurasi sistem Anda
# Command: cp .env.contoh .env
# ============================================================

# ------------------------------------------------------------
# APLIKASI UTAMA
# ------------------------------------------------------------
APP_NAME="Koleksi Buku"
APP_ENV=local
APP_KEY=base64:GENERATE_APP_KEY_ANDI_DISINI
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locale & Language Configuration
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------
# MAINTENANCE MODE
# ------------------------------------------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------
# DATABASE - POSTGRESQL
# ------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=koleksi_buku
DB_USERNAME=postgres
DB_PASSWORD=DATABASE_PASSWORD_ANDA

# Catatan: Untuk MySQL, gunakan konfigurasi berikut:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nama_database_anda
# DB_USERNAME=root
# DB_PASSWORD=mysql_password_anda

# ------------------------------------------------------------
# SESSION & CACHE
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# ------------------------------------------------------------
# REDIS (Opsional - Hanya jika menggunakan Redis)
# ------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------
# MEMCACHED (Opsional)
# ------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

# ------------------------------------------------------------
# EMAIL - SMTP GMAIL
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Nama Aplikasi"

# Catatan:
# - Gunakan App Password dari Google Account Settings
# - Bukan password Gmail biasa
# - Link: https://myaccount.google.com/apppasswords

# ------------------------------------------------------------
# AWS S3 (Opsional - Untuk file storage di cloud)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------
# VITE (Frontend Build Tool)
# ------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------
# GOOGLE OAUTH LOGIN
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback

# Catatan:
# - Buat OAuth 2.0 Client di Google Cloud Console
# - Set Authorized Redirect URIs sesuai domain Anda
# - Link: https://console.cloud.google.com/apis/credentials

# ------------------------------------------------------------
# MIDTRANS - PAYMENT GATEWAY
# ------------------------------------------------------------
MIDTRANS_MERCHANT_ID=YOUR_MERCHANT_ID
MIDTRANS_SERVER_KEY=YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Catatan:
# - Ambil credentials dari Dashboard Midtrans
# - IS_PRODUCTION=false untuk sandbox mode
# - IS_PRODUCTION=true untuk production mode
# - Link: https://dashboard.midtrans.com

# ============================================================
# PANDUAN INSTALLASI
# ============================================================
#
# 1. Install Dependencies:
#    composer install
#    npm install
#
# 2. Generate Application Key:
#    php artisan key:generate
#
# 3. Setup Database:
#    - Buat database PostgreSQL/MySQL
#    - Sesuaikan konfigurasi DB di atas
#    - Run migration: php artisan migrate
#
# 4. Link Storage (Opsional):
#    php artisan storage:link
#
# 5. Build Assets:
#    npm run build
#
# 6. Start Development Server:
#    php artisan serve
#
# 7. Buka Browser:
#    http://localhost:8000
#
# ============================================================
